; Hooks for the Tauri NSIS panel installer (bundle.windows.nsis.installerHooks).
; Adds the Windows 11 first-level Explorer entry on install and removes it on uninstall.
; The panel installer never installs the agent (a PC is either watcher or watched).
; installer-strings.nsh is generated by scripts/build-installers.ps1 from locales/*.json.

!include "LogicLib.nsh"
!include "${__FILEDIR__}\generated\installer-strings.nsh"

!macro DrPanelText KEY
  ${If} $LANGUAGE == 1055
    StrCpy $R9 "${STR_TR_${KEY}}"
  ${Else}
    StrCpy $R9 "${STR_EN_${KEY}}"
  ${EndIf}
!macroend

!macro NSIS_HOOK_PREINSTALL
!macroend

!macro NSIS_HOOK_POSTINSTALL
  !insertmacro DrPanelText menu_register
  DetailPrint "$R9"
  ; Trust the package certificate machine-wide (needs the elevated, per-machine install; a
  ; per-user install skips it and keeps the classic menu entry), then let the panel register
  ; the sparse package for this user. Both steps are best effort.
  nsExec::ExecToLog '"$SYSDIR\certutil.exe" -addstore -f TrustedPeople "$INSTDIR\DeskRemote-Menu.cer"'
  Pop $R8
  nsExec::ExecToLog '"$INSTDIR\desk-panel.exe" --enable-shell-menu'
  Pop $R8
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro DrPanelText menu_remove
  DetailPrint "$R9"
  nsExec::ExecToLog '"$INSTDIR\desk-panel.exe" --remove-shell-menu'
  Pop $R8
  nsExec::ExecToLog '"$SYSDIR\certutil.exe" -delstore TrustedPeople ${MENU_CERT_SHA1}'
  Pop $R8
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
!macroend
